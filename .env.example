# Server-only: pooled Neon PostgreSQL connection string for app traffic.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_POOLER_HOST/madclothes?sslmode=require

# Public Neon Auth endpoint and server-side JWKS URL for verifying JWTs.
VITE_NEON_AUTH_URL=https://ep-delicate-field-bawa02pg.neonauth.c-8.eu-central-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-delicate-field-bawa02pg.neonauth.c-8.eu-central-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Optional canonical origin for robots.txt and sitemap.xml. Defaults to the request origin.
PUBLIC_SITE_URL=

# Add comma-separated account emails that should receive the server-managed admin role.
ADMIN_EMAIL_ALLOWLIST=

# Cloudflare R2: server-only credentials; leave the endpoint empty to derive it from R2_ACCOUNT_ID.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=madclothes-images
R2_S3_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional public domain. When empty, the API returns one-hour signed image URLs.
R2_PUBLIC_BASE_URL=

# Payment integrations remain disabled until provider access and credentials are supplied.
MTN_MOMO_API_BASE_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
RTL_MONEY_API_BASE_URL=
RTL_MONEY_API_KEY=
